{
    "include": ["src"],
    "exclude": ["node_modules", "**/*.spec.ts"],
    "compilerOptions": {
        "rootDir": "src",
        "incremental": true,
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "strict": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true
    }
}
